DISCORD_TOKEN=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Container paths: leave these two as-is for Docker (docker-compose.yml's
# bind mounts put config.yaml/data/newsbot.db at exactly these paths inside
# the container). Running the CLI locally without Docker? Don't source this
# whole file to get secrets into your shell: these two would then point a
# local process at paths that only exist inside a container. Export just the
# secret(s) you need instead, and pass --config/--db on the command line.
# See docs/self-host.md's "Running the CLI locally" section.
NEWSBOT_CONFIG=/app/config.yaml
NEWSBOT_DB=/data/newsbot.db
# A URL or an email a source's admin (Reddit's especially) can use to reach
# whoever's running this bot. Goes into the User-Agent on every outbound
# request; unset, it falls back to the repo URL and says so plainly, and
# the bot logs one startup warning about it.
NEWSBOT_CONTACT=
